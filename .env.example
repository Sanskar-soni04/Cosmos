# ==============================================================================
# AICTE National Regulatory & Approval Workflow Platform (.env.example)
# APH 2024-27 Reference Architecture & Demo Environment
# ==============================================================================

# Database
DATABASE_URL=postgresql://aicte_user:aicte_secure_pass@localhost:5432/aicte_db
POSTGRES_USER=aicte_user
POSTGRES_PASSWORD=aicte_secure_pass
POSTGRES_DB=aicte_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=aicte_minio_admin
MINIO_SECRET_KEY=aicte_minio_secret_key_2026
MINIO_BUCKET_DOCS=aicte-dossiers-vault
MINIO_USE_SSL=false

# Authentication & Security
JWT_SECRET_KEY=aicte_jwt_production_master_secret_key_256bit
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & Verification Subsystem
LLM_PROVIDER=mock # Options: mock, openai, anthropic, gemini
LLM_API_KEY=mock-key-not-required-for-demo
OCR_ENGINE=paddleocr # Options: paddleocr, tesseract, pypdf
OCR_CONFIDENCE_THRESHOLD=0.85

# Time & Clock Simulator
TIMEZONE=Asia/Kolkata
ENABLE_SIMULATED_CLOCK=true

# Notification & Communications
SMTP_HOST=localhost
SMTP_PORT=1025
SMS_GATEWAY_PROVIDER=mock
WHATSAPP_GATEWAY_PROVIDER=mock
